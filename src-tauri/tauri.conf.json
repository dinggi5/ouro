{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Ouro",
  "version": "0.1.1",
  "identifier": "com.dinggi5.ouro",
  "build": {
    "beforeDevCommand": "./scripts/build-sidecars.sh && npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "./scripts/build-sidecars.sh && npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "title": "Ouro",
        "width": 420,
        "height": 640,
        "resizable": false,
        "decorations": false,
        "transparent": true,
        "shadow": true,
        "visible": false,
        "skipTaskbar": true,
        "center": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self'; img-src 'self' data:; connect-src ipc: http://ipc.localhost; form-action 'none'; base-uri 'none'",
      "devCsp": "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; font-src 'self'; img-src 'self' data:; connect-src 'self' ws://localhost:1420 ipc: http://ipc.localhost; form-action 'none'; base-uri 'none'"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDZCMzlERjdBMzBFREVENTgKUldSWTdlMHdldDg1YXpnZXRKM3VoblB2OStjR1VBaXZWV1dDR0xNOUorU1gzY2xrOUlXL0xlSlYK",
      "endpoints": [
        "https://github.com/dinggi5/ouro/releases/latest/download/latest.json"
      ]
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "dmg"
    ],
    "externalBin": [
      "binaries/ouro-mcp"
    ],
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "Productivity",
    "copyright": "© 2026 dinggi5. MIT License.",
    "shortDescription": "선순환 캘린더",
    "longDescription": "이 맥에만 저장되는 메뉴바 캘린더. 정해진 시간에 Claude·Codex 에게 일을 부탁하고, 답을 다시 캘린더에 걸어 둔다.",
    "macOS": {
      "hardenedRuntime": true,
      "minimumSystemVersion": "11.0"
    }
  }
}
