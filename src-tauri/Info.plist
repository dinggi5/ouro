<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Tauri 가 만든 Info.plist 위에 덮인다(이 파일 값이 이긴다).
  · LSUIElement — 도크 아이콘 없이 메뉴바에만 산다(lib.rs run() 주석).
  · LSMinimumSystemVersion 26.0 — 최소 macOS 의 정본은 여기다(PLAN §13). tauri.conf.json 의 minimumSystemVersion 은
    일부러 11.0 이다: Tauri 가 그 값을 MACOSX_DEPLOYMENT_TARGET 으로 cargo 빌드 전체에 넘기는데, Xcode 27 링커(ld-27037)는
    배포 타깃 26.0 으로 링크한 proc-macro dylib 을 dyld 가 «mis-aligned LINKEDIT string pool» 로 거부하는 모양으로 만든다 —
    rustc 가 «can't find crate for `phf_macros`» 로 죽는다(개발 8 실측: 26.0 은 깨지고 11.0·미설정은 정상).
    링커가 고쳐지면 minimumSystemVersion 을 26.0 으로 되돌리고 이 줄을 지운다. release.sh 가 앱의 값이 26.0 인지 확인한다.
-->
<plist version="1.0">
<dict>
	<key>LSUIElement</key>
	<true/>
	<key>LSMinimumSystemVersion</key>
	<string>26.0</string>
</dict>
</plist>
