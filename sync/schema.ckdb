DEFINE SCHEMA

    RECORD TYPE Config (
        "___createTime" TIMESTAMP,
        "___createdBy"  REFERENCE,
        "___etag"       STRING,
        "___modTime"    TIMESTAMP,
        "___modifiedBy" REFERENCE,
        "___recordID"   REFERENCE QUERYABLE,
        device          STRING QUERYABLE SORTABLE,
        name            STRING QUERYABLE SORTABLE,
        at              INT64 QUERYABLE SORTABLE,
        GRANT WRITE TO "_creator",
        GRANT CREATE TO "_icloud",
        GRANT READ TO "_world"
    );

    RECORD TYPE Item (
        "___createTime" TIMESTAMP,
        "___createdBy"  REFERENCE,
        "___etag"       STRING,
        "___modTime"    TIMESTAMP,
        "___modifiedBy" REFERENCE,
        "___recordID"   REFERENCE QUERYABLE,
        kind            STRING QUERYABLE SORTABLE,
        all_day         INT64 QUERYABLE SORTABLE,
        start_at        INT64 QUERYABLE SORTABLE,
        end_at          INT64 QUERYABLE SORTABLE,
        start_date      STRING QUERYABLE SORTABLE,
        end_date        STRING QUERYABLE SORTABLE,
        tz              STRING QUERYABLE SORTABLE,
        rrule           STRING QUERYABLE SORTABLE,
        alert_min       INT64 QUERYABLE SORTABLE,
        private         INT64 QUERYABLE SORTABLE,
        origin          STRING QUERYABLE SORTABLE,
        created_at      INT64 QUERYABLE SORTABLE,
        updated_at      INT64 QUERYABLE SORTABLE,
        deleted_at      INT64 QUERYABLE SORTABLE,
        title           ENCRYPTED STRING,
        notes           ENCRYPTED STRING,
        target          STRING QUERYABLE SORTABLE,
        allowed_tools   STRING QUERYABLE SORTABLE,
        approved_at     INT64 QUERYABLE SORTABLE,
        depth           INT64 QUERYABLE SORTABLE,
        late            STRING QUERYABLE SORTABLE,
        carry           INT64 QUERYABLE SORTABLE,
        wall_time       STRING QUERYABLE SORTABLE,
        prompt          ENCRYPTED STRING,
        workdir         ENCRYPTED STRING,
        resume_session  ENCRYPTED STRING,
        parent_run      STRING QUERYABLE SORTABLE,
        resume_run      STRING QUERYABLE SORTABLE,
        series          STRING QUERYABLE SORTABLE,
        folder          STRING QUERYABLE SORTABLE,
        GRANT WRITE TO "_creator",
        GRANT CREATE TO "_icloud",
        GRANT READ TO "_world"
    );

    RECORD TYPE Run (
        "___createTime" TIMESTAMP,
        "___createdBy"  REFERENCE,
        "___etag"       STRING,
        "___modTime"    TIMESTAMP,
        "___modifiedBy" REFERENCE,
        "___recordID"   REFERENCE QUERYABLE,
        started_at      INT64 QUERYABLE SORTABLE,
        finished_at     INT64 QUERYABLE SORTABLE,
        exit_code       INT64 QUERYABLE SORTABLE,
        status          STRING QUERYABLE SORTABLE,
        late_ms         INT64 QUERYABLE SORTABLE,
        read_at         INT64 QUERYABLE SORTABLE,
        device          STRING QUERYABLE SORTABLE,
        item            STRING QUERYABLE SORTABLE,
        sent_text       ENCRYPTED STRING,
        response        ENCRYPTED STRING,
        stderr          ENCRYPTED STRING,
        session_id      ENCRYPTED STRING,
        resumed_session ENCRYPTED STRING,
        GRANT WRITE TO "_creator",
        GRANT CREATE TO "_icloud",
        GRANT READ TO "_world"
    );

    RECORD TYPE Proposal (
        "___createTime" TIMESTAMP,
        "___createdBy"  REFERENCE,
        "___etag"       STRING,
        "___modTime"    TIMESTAMP,
        "___modifiedBy" REFERENCE,
        "___recordID"   REFERENCE QUERYABLE,
        all_day         INT64 QUERYABLE SORTABLE,
        start_at        INT64 QUERYABLE SORTABLE,
        end_at          INT64 QUERYABLE SORTABLE,
        start_date      STRING QUERYABLE SORTABLE,
        end_date        STRING QUERYABLE SORTABLE,
        alert_min       INT64 QUERYABLE SORTABLE,
        status          STRING QUERYABLE SORTABLE,
        created_at      INT64 QUERYABLE SORTABLE,
        decided_at      INT64 QUERYABLE SORTABLE,
        event           STRING QUERYABLE SORTABLE,
        client          ENCRYPTED STRING,
        title           ENCRYPTED STRING,
        notes           ENCRYPTED STRING,
        GRANT WRITE TO "_creator",
        GRANT CREATE TO "_icloud",
        GRANT READ TO "_world"
    );

    RECORD TYPE ErrandProposal (
        "___createTime" TIMESTAMP,
        "___createdBy"  REFERENCE,
        "___etag"       STRING,
        "___modTime"    TIMESTAMP,
        "___modifiedBy" REFERENCE,
        "___recordID"   REFERENCE QUERYABLE,
        start_at        INT64 QUERYABLE SORTABLE,
        allowed_tools   STRING QUERYABLE SORTABLE,
        late            STRING QUERYABLE SORTABLE,
        depth           INT64 QUERYABLE SORTABLE,
        status          STRING QUERYABLE SORTABLE,
        created_at      INT64 QUERYABLE SORTABLE,
        decided_at      INT64 QUERYABLE SORTABLE,
        target          STRING QUERYABLE SORTABLE,
        parent_run      STRING QUERYABLE SORTABLE,
        errand          STRING QUERYABLE SORTABLE,
        client          ENCRYPTED STRING,
        prompt          ENCRYPTED STRING,
        GRANT WRITE TO "_creator",
        GRANT CREATE TO "_icloud",
        GRANT READ TO "_world"
    );

    RECORD TYPE Users (
        "___createTime" TIMESTAMP,
        "___createdBy"  REFERENCE,
        "___etag"       STRING,
        "___modTime"    TIMESTAMP,
        "___modifiedBy" REFERENCE,
        "___recordID"   REFERENCE,
        roles           LIST<INT64>,
        GRANT WRITE TO "_creator",
        GRANT READ TO "_world"
    );
